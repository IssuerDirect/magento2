    {
        "*": {
            "StripeIntegration_Payments/js/view/customer/payment-methods-initializer": {
                "initParams": <?= /* @noEscape */ $block->getInitParams(); ?>,
                "mode": "new_subscription_payment_method"
            }
        }
    }
</script>
